{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "airo-wp/icon-list",
	"version": "1.0.0",
	"title": "Icon List",
	"category": "text",
	"description": "List of items with an icon beside each title and description, like a List block with icons. Use for features, benefits, services, checklists, 'why choose us', contact details, and pricing plan inclusions.",
	"keywords": [
		"icon list",
		"list",
		"checklist",
		"features",
		"benefits",
		"services",
		"why choose us",
		"check",
		"bullet",
		"icon",
		"opening hours",
		"what's included",
		"amenities",
		"pros and cons"
	],
	"textdomain": "airo-wp",
	"icon": "list-view",
	"supports": {
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"textAlign": true,
		"html": false,
		"inserter": true,
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": false,
			"__experimentalDefaultControls": {
				"margin": true,
				"padding": true
			}
		},
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalDefaultControls": {
				"fontSize": true,
				"lineHeight": true
			}
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"radius": true
			}
		}
	},
	"providesContext": {
		"airo-wp/iconList/layout": "layout",
		"airo-wp/iconList/iconSize": "iconSize",
		"airo-wp/iconList/iconStyle": "iconStyle",
		"airo-wp/iconList/strokeWidth": "strokeWidth",
		"airo-wp/iconList/iconColor": "iconColor",
		"airo-wp/iconList/iconBackgroundColor": "iconBackgroundColor",
		"airo-wp/iconList/gap": "gap",
		"airo-wp/iconList/iconPosition": "iconPosition",
		"airo-wp/iconList/iconVerticalAlignment": "iconVerticalAlignment"
	},
	"attributes": {
		"layout": {
			"type": "string",
			"default": "vertical"
		},
		"iconSize": {
			"type": "number"
		},
		"iconStyle": {
			"type": "string",
			"enum": [
				"filled",
				"outlined"
			]
		},
		"strokeWidth": {
			"type": "number",
			"default": 1.5
		},
		"iconColor": {
			"type": "string",
			"default": ""
		},
		"iconBackgroundColor": {
			"type": "string",
			"default": ""
		},
		"gap": {
			"type": "string",
			"default": "24px"
		},
		"iconPosition": {
			"type": "string",
			"default": "left"
		},
		"columns": {
			"type": "number",
			"default": 1
		},
		"columnMinWidth": {
			"type": "string",
			"default": ""
		},
		"alignment": {
			"type": "string",
			"default": "left"
		},
		"iconVerticalAlignment": {
			"type": "string",
			"enum": [
				"top",
				"center"
			],
			"default": "top"
		}
	},
	"example": {
		"attributes": {
			"layout": "vertical",
			"iconSize": 32,
			"gap": "24px"
		},
		"innerBlocks": [
			{
				"name": "airo-wp/icon-list-item",
				"attributes": {
					"icon": "check"
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "<strong>Feature One</strong> — description of the first feature"
						}
					}
				]
			},
			{
				"name": "airo-wp/icon-list-item",
				"attributes": {
					"icon": "star"
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "<strong>Feature Two</strong> — description of the second feature"
						}
					}
				]
			},
			{
				"name": "airo-wp/icon-list-item",
				"attributes": {
					"icon": "rocket"
				},
				"innerBlocks": [
					{
						"name": "core/paragraph",
						"attributes": {
							"content": "<strong>Feature Three</strong> — description of the third feature"
						}
					}
				]
			}
		]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
