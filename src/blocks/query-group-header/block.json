{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "airo-wp/query-group-header",
  "version": "1.0.0",
  "title": "Query Group Header",
  "category": "airo-wp",
  "description": "Renders once per group inside a Query with group-by enabled. Use block bindings or context to display the group label.",
  "keywords": ["query", "group", "header", "section"],
  "textdomain": "airo-wp",
  "icon": "list-view",
  "parent": ["airo-wp/query"],
  "usesContext": ["airo-wp/queryId", "airo-wp/groupLabel", "airo-wp/groupValue"],
  "supports": {
    "anchor": true,
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "attributes": {
    "tagName": { "type": "string", "default": "header" }
  },
  "example": { "attributes": {} },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
