# Local-only artifacts. /tests/e2e/.auth/ and /artifacts/storage-states/ hold
# Playwright storageState — live login cookies from a local e2e run. Never commit
# them anywhere: a committed session file is a credential leak, not a stale fixture.
/.env.local
/tests/e2e/.auth/
/tests/e2e/check-plugin/.plugin-check-excludes
/artifacts/storage-states/*.json
